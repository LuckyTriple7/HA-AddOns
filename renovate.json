{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Renovate pflegt für die Alpine-Add-ons Base-Images (FROM, ARG BUILD_FROM, build.yaml) und die gepinnten Alpine-Pakete.",
    "pip, npm, GitHub Actions und die Docker-Images der übrigen Add-ons bleiben bei Dependabot.",
    "Neues Add-on: in includePaths aufnehmen, FROM-Tag mit -alpine3.XX festziehen, apk-Pakete pinnen und seinen docker-Eintrag aus .github/dependabot.yml entfernen.",
    "Alpine-Sprung (z. B. 3.24 -> 3.25) von Hand: alle -alpine3.XX-Tags, alle Pins und die Repo-URLs unten in einem Zug umstellen."
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "includePaths": [
    "anubis/**",
    "cardboard/**",
    "claudecode/**",
    "crowdpanel/**",
    "gitpulse/**",
    "mariadb2/**",
    "mediagrab/**",
    "messenger-portal/**",
    "mypage/**",
    "nettoolbox/**",
    "phpmyadmin-mariadb2/**",
    "syswatch/**",
    "telegram/**",
    "whatsapp/**"
  ],
  "enabledManagers": [
    "dockerfile",
    "custom.regex"
  ],
  "dependencyDashboard": false,
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "dependencies"
  ],
  "additionalBranchPrefix": "{{parentDir}}-",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "from {{currentVersion}} to {{newVersion}}",
  "commitMessageSuffix": "in /{{parentDir}}",
  "customDatasources": {
    "alpine": {
      "defaultRegistryUrlTemplate": "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/",
      "format": "html"
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Base-Image in ARG BUILD_FROM und build.yaml",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/(^|/)build\\.yaml$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG BUILD_FROM=(?<depName>.*?):(?<currentValue>.*?)\\s+",
        "(aarch64|amd64):\\s[\"']?(?<depName>.*?):(?<currentValue>.*?)[\"']?\\s"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "ARG-Versionen mit Kommentar '# renovate: datasource=... depName=...' in der Zeile davor",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+ARG\\s+[A-Z0-9_]+=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Gepinnte Alpine-Pakete (paket=version) in Dockerfiles",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s+"
      ],
      "versioningTemplate": "loose",
      "datasourceTemplate": "custom.alpine",
      "depNameTemplate": "alpine_3_24/{{package}}",
      "extractVersionTemplate": "^{{{package}}}-(?<version>\\d.*)\\.apk$"
    }
  ],
  "packageRules": [
    {
      "description": "Pakete aus dem community-Repo von Alpine (Liste beim Pinnen neuer Pakete ergänzen)",
      "matchDatasources": [
        "custom.alpine"
      ],
      "matchDepNames": [
        "/^alpine_3_24/php84/",
        "/^alpine_3_24/(chromium|chromium-chromedriver|docker-cli|ffmpeg|font-noto|font-noto-emoji|github-cli|libmodbus|libmodbus-dev|npm|ripgrep|traceroute|vim)$/"
      ],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine/v3.24/community/x86_64/"
      ]
    },
    {
      "description": "Alle Alpine-Pakete eines Add-ons in einem PR (chromium und chromium-chromedriver müssen zusammen steigen)",
      "matchDatasources": [
        "custom.alpine"
      ],
      "groupName": "Alpine-Pakete"
    },
    {
      "description": "Base-Images eines Add-ons in einem PR",
      "matchDatasources": [
        "docker"
      ],
      "groupName": "Base-Image"
    },
    {
      "description": "Alpine-Sprünge nur von Hand, sonst passen die Paket-Pins nicht mehr",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "alpine"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "Neue Hauptversion des hassio-addons-Base-Images bringt ein neues Alpine, deshalb nur von Hand",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ghcr.io/hassio-addons/base"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "mypage hatte nie automatische Python-Updates; Sprung auf eine neue Python-Version von Hand testen",
      "matchFileNames": [
        "mypage/Dockerfile"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ]
}
