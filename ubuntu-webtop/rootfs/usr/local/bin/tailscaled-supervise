#!/bin/bash
# Haelt tailscaled am Leben: startet den Daemon neu, falls er sich beendet.
# Wird von /etc/cont-init.d/43-tailscale.sh im Hintergrund gestartet.
#
# Aufruf: tailscaled-supervise <statedir> <socket> <logfile> [weitere tailscaled-Argumente]
#
# Achtung: tailscaled kennt nur -tun -state -statedir -socket -port
# -socks5-server -outbound-http-proxy-listen. Netzwerk-Einstellungen wie
# --netfilter-mode, --accept-routes usw. gehoeren an "tailscale up"/"set",
# nicht an den Daemon - sonst wirft er seine Usage aus und beendet sich.

STATE_DIR="$1"
SOCKET="$2"
LOGFILE="$3"
shift 3

while true; do
    /usr/local/bin/tailscaled \
        --statedir="$STATE_DIR" \
        --socket="$SOCKET" \
        --port=41641 \
        "$@" >>"$LOGFILE" 2>&1
    RC=$?
    echo "[tailscale] $(date '+%Y-%m-%d %H:%M:%S') tailscaled beendet (Code ${RC}) - Neustart in 5s" >>"$LOGFILE"
    sleep 5
done
