#!/bin/sh
OPTIONS=/data/options.json
OCC=/app/www/public/occ
CONFIG_PHP=/config/www/nextcloud/config/config.php

UPDATE=$(jq -r '.update_wopi_ip // false' "$OPTIONS" 2>/dev/null || echo false)
if [ "$UPDATE" != "true" ]; then
    exec sleep 2147483647
fi

echo "[wopi-updater] enabled — waiting for Nextcloud..."
until grep -q "'installed' => true" "$CONFIG_PHP" 2>/dev/null; do
    sleep 10
done
echo "[wopi-updater] Nextcloud ready"

# Proxy-Netze aus den Optionen — bei lokalem Reverse-Proxy (NPMplus, NGINX Proxy
# Manager) erreicht Collabora Nextcloud intern, die Quelle ist dann nie die
# externe IP. Ohne diese Netze in der Allowlist antwortet Nextcloud mit 403.
PROXIES=$(jq -r '.trusted_proxies // "172.30.32.0/23"' "$OPTIONS" 2>/dev/null || echo "172.30.32.0/23")
PROXIES=$(echo "$PROXIES" | tr -d ' \r' | sed 's/,*$//')
[ -z "$PROXIES" ] && PROXIES="172.30.32.0/23"

LAST_ALLOW=""
while true; do
    IP=$(curl -sf --max-time 10 "https://checkip.dyndns.org" 2>/dev/null \
        | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    if [ -z "$IP" ]; then
        IP=$(curl -sf --max-time 10 "https://ifconfig.me" 2>/dev/null \
            | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    fi

    if [ -z "$IP" ]; then
        echo "[wopi-updater] WARN: could not determine external IP"
        ALLOW="$PROXIES"
    else
        ALLOW="${IP},${PROXIES}"
    fi

    if [ "$ALLOW" != "$LAST_ALLOW" ]; then
        echo "[wopi-updater] allowlist changed: ${LAST_ALLOW:-none} → ${ALLOW}"
        if ALLOW_ROOT=1 php "$OCC" config:app:set richdocuments wopi_allowlist --value="$ALLOW" 2>&1; then
            echo "[wopi-updater] OK: wopi_allowlist=${ALLOW}"
            LAST_ALLOW="$ALLOW"
        else
            echo "[wopi-updater] WARN: occ failed — will retry next cycle"
        fi
    fi

    sleep 150
done
